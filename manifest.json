{
  "manifest_version": 3,
  "name": "KeepTabs — never lose a tab",
  "version": "1.0.0",
  "description": "Save all your tabs in one click with automatic version backups. Never lose them. Local-first, no account, no subscription.",
  "permissions": ["tabs", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Save this window (KeepTabs)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
